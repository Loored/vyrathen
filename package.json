{
  "name": "vyrathen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:ui": "playwright test",
    "review:ui": "playwright test --project=chromium",
    "test:ui:ci": "playwright test --config=playwright.ci.config.ts --project=chromium",
    "design:dev": "vite --config .design-sync/vite.config.mjs --host 127.0.0.1 --port 4174",
    "design:typecheck": "node scripts/design-sync-contracts.mjs",
    "design:build": "npm run design:typecheck && vite build --config .design-sync/vite.config.mjs && node scripts/design-sync-build-check.mjs",
    "design:preview": "vite preview --config .design-sync/vite.config.mjs --host 127.0.0.1 --port 4174",
    "design:test": "playwright test --config=playwright.ci.config.ts --project=chromium design-sync.spec.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  }
}
